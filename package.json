{
  "name": "kanken-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "rescript build && next dev --turbopack",
    "res:build": "rescript build",
    "res:watch": "rescript build -w",
    "res:clean": "rescript clean",
    "build": "rescript build && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "rescript build && vitest",
    "test:ui": "rescript build && vitest --ui",
    "coverage": "rescript build && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --preset=mobile",
    "lhci:desktop": "lhci autorun --preset=desktop"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.16.0",
    "@rescript/core": "^1.6.1",
    "@rescript/react": "^0.15.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.0",
    "rescript": "^12.3.0",
    "tailwindcss": "^4",
    "three": "^0.187.0",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "**/postcss": "^8.5.23",
    "**/basic-ftp": "^6.2.1",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1"
  }
}
